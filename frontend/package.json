{
  "name": "review-ai-dashboard-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src index.html",
    "format:check": "prettier --check src index.html",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "pinia": "^2.2.6",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^14.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.1.10"
  }
}
