# ─── Review AI Dashboard — environment variables ────────────────────────────
#
# Set these in one Northflank secret group (Secrets → Create secret group), so
# both the `app` and the `worker` service get them — the worker runs the AI
# analysis and needs the AI keys too.  Never commit real values.  Values
# marked "!" are required in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database and queue (from the linked addons) ─────────────────────────────
# ! Link the PostgreSQL and Redis addons under these names.  A plain
# postgresql:// URL is switched to the psycopg driver automatically, and a
# TLS rediss:// URL gets ssl_cert_reqs=required.
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://host:6379/0

# ── Runtime environment ────────────────────────────────────────────────────
# production refuses to start with placeholder secrets, marks the session
# cookie Secure and hides Swagger.
ENVIRONMENT=production

# ── Demo data ──────────────────────────────────────────────────────────────
# true fills an EMPTY database with 100 demo reviews at start, in any
# environment; a database that already has reviews is never touched.
SEED_DEMO_DATA=true

# ── JWT security ───────────────────────────────────────────────────────────
# ! At least 32 random bytes:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=30

# ── Administrator credentials ──────────────────────────────────────────────
# ! The login of the admin dashboard. The local demo account is admin-artem-leo / password-artem-leo.
# For a deployed environment, generate a hash with
#     python3 scripts/hash_password.py
# inside backend/ and use ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD.
ADMIN_EMAIL=admin-artem-leo
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=password-artem-leo

# ── AI providers ───────────────────────────────────────────────────────────
# auto = Groq when its key is set, otherwise Gemini, otherwise the offline stub.
# With both keys empty the application still works with the built-in stub
# analyser.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Logging ────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR.  Logs go to stdout (Northflank → Logs).
LOG_LEVEL=INFO
# Optional: also write a rotating log file (5 MiB, 3 backups) to a writable path.
# LOG_FILE=/tmp/app.log
